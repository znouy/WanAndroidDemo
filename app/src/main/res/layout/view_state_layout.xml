<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:parentTag="android.widget.FrameLayout">

    <!-- ================= 状态一：加载中 (M3 弹性转圈，保持不变) ================= -->
    <LinearLayout
        android:id="@+id/layoutStateLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorSize="40dp"
            app:trackThickness="4dp"
            app:indicatorColor="#2f74e5" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="正在加载，请稍候..."
            android:textColor="#999999"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ================= 💡 状态二：空数据（极致扁平化：干掉外层容器与 ImageView，用单一 TextView 复合展现） ================= -->
    <TextView
        android:id="@+id/tvEmptyMsg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="这里什么都没有哦"
        android:textColor="#999999"
        android:textSize="13sp"
        android:drawableTop="@android:drawable/ic_menu_today"
        android:drawablePadding="12dp"
        android:drawableTint="#DCDCDC"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ================= 状态三：加载失败（提示 + 重试按钮，提示字图合一） ================= -->
    <LinearLayout
        android:id="@+id/layoutStateError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingHorizontal="32dp">

        <!-- 💡 极致扁平化：警告图标直接作为复合图片画在 TextView 头部 -->
        <TextView
            android:id="@+id/tvErrorMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="加载失败，请检查网络后重试"
            android:textColor="#666666"
            android:textSize="14sp"
            android:drawableTop="@android:drawable/stat_notify_error"
            android:drawablePadding="12dp"
            android:drawableTint="#FF4D4F" />

        <!-- 💡 兼容处理：去掉了硬编码的 M3 Style 声明，自动适配任何版本主题 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="点击重试"
            android:textSize="13sp"
            android:backgroundTint="#2f74e5"
            app:cornerRadius="8dp" />
    </LinearLayout>

</merge>