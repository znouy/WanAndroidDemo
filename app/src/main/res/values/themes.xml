<resources>

    <style name="Theme.WanAndroidDemo" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!--应用程序的主要主题颜色,用于主要的 UI 元素:AppBar（工具栏）、按钮背景、活动栏等-->
        <item name="colorPrimary">@color/theme_color</item>
        <!-- 状态栏的颜色 -->
        <item name="android:statusBarColor">@color/theme_color</item>
        <!-- 如果是 Light 主题，图标通常是深色的。如果你的状态栏是深粉色，建议改为白色图标： -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- 💡 让整个 Activity 窗口背景自动跟随日夜间色值变换 -->
        <item name="android:windowBackground">@color/theme_background</item>

        <!--  <item name="colorPrimary">@color/theme_color</item>  -->  <!--导航栏颜色-->
        <!--  <item name="colorPrimaryDark">@color/white</item>    -->  <!--通知栏颜色 状态栏-->
        <!--  <item name="colorAccent">@color/theme_color</item>   --><!--控件选中后颜色-->
        <!--  <item name="android:windowLightStatusBar">true</item>-->   <!--沉浸式状态栏字体颜色跟着状态蓝变化-->


    </style>

    <style name="CircleStyle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>


    <style name="NavDrawerItemStyle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">16sp</item>
    </style>

    <!-- 启动屏主题 -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.WanAndroidDemo</item>
    </style>

    <style name="Theme.Language" parent="Theme.WanAndroidDemo">
        <!-- 设置窗口背景色，避免重建时出现闪黑 -->
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- 自定义 Tab 文本样式 -->
    <style name="Theme.TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">16sp</item> <!-- 在这里设置字体大小 -->
        <!-- 如果需要，也可以在这里设置英文字母大小写转换等属性 -->
        <item name="textAllCaps">false</item>
    </style>

    <!-- SearchView 的白字白图标专属局部主题 -->
    <style name="Theme.SearchView.WhiteText" parent="Theme.AppCompat.Light">
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColorHint">#B0FFFFFF</item>
        <item name="colorControlNormal">@color/white</item>
    </style>
    <!-- 在 themes.xml 中添加 -->
    <style name="Theme.ToolbarMenu" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:actionMenuTextColor">@android:color/white</item>
    </style>
</resources>